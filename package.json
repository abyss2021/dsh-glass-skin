{
  "name": "dsh-glass-skin",
  "version": "0.3.0",
  "description": "Clear glass skin for the Harness Web UI: aurora or a chosen image canvas, translucent panes, one hairline",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abyss2021/dsh-glass-skin.git"
  },
  "homepage": "https://github.com/abyss2021/dsh-glass-skin#readme",
  "bugs": {
    "url": "https://github.com/abyss2021/dsh-glass-skin/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "skin",
    "glass",
    "web-ui"
  ],
  "author": "abyss2021",
  "type": "module",
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-0 <0.3.0-0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/*.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    },
    "compatibility": {
      "dsh": "0.2.1-rc.2",
      "profiles": [
        "web"
      ],
      "dshReleases": {
        "0.2.1-rc.2": "compatible",
        "0.2.2-rc.1": "compatible"
      }
    }
  },
  "license": "MIT"
}
