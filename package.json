{
  "name": "@local/glass-skin",
  "version": "0.1.0",
  "private": true,
  "description": "Clear glass skin for the Harness Web UI: aurora or a chosen image canvas, translucent panes, one hairline",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abyss2021/dsh-glass-skin.git"
  },
  "homepage": "https://github.com/abyss2021/dsh-glass-skin#readme",
  "bugs": {
    "url": "https://github.com/abyss2021/dsh-glass-skin/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "skin",
    "glass",
    "web-ui"
  ],
  "author": "abyss2021",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  },
  "license": "MIT"
}
